@model Client
@{ ViewData["Title"] = "Eliminar cliente"; }
<div class="page-heading narrow-heading"><span class="eyebrow text-danger">Ação irreversível</span><h1>Eliminar @Model.Name?</h1><p>Os interesses associados também serão eliminados. Clientes com visitas não podem ser removidos.</p></div>
<form method="post" class="content-card confirm-card"><p>Confirme que pretende eliminar permanentemente este cliente.</p><div class="form-actions"><button class="btn btn-danger" type="submit">Sim, eliminar</button><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a></div></form>
