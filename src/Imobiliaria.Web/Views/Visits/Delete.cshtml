@model Visit
@{ ViewData["Title"] = "Eliminar visita"; }
<div class="page-heading narrow-heading"><span class="eyebrow text-danger">Confirmar eliminação</span><h1>Eliminar visita?</h1><p>@Model.Client.Name · @Model.Property.Title<br />@Model.ScheduledAt.ToString("dd MMM yyyy · HH:mm")</p></div>
<form method="post" class="content-card confirm-card"><p>A visita será removida permanentemente da agenda.</p><div class="form-actions"><button class="btn btn-danger" type="submit">Sim, eliminar</button><a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a></div></form>
