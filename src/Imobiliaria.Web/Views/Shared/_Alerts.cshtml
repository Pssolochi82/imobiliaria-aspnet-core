@if (TempData["Success"] is string success)
{
    <div class="alert app-alert app-alert-success alert-dismissible fade show" role="status">
        <strong>Concluído.</strong> @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert app-alert app-alert-error alert-dismissible fade show" role="alert">
        <strong>Atenção.</strong> @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
}
